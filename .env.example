# Base de datos (en local: la de docker-compose; en Railway: referencia al Postgres del proyecto)
DATABASE_URL="postgresql://repartidores:repartidores@localhost:5433/repartidores"

# Clave de la API de Anthropic (solo servidor)
ANTHROPIC_API_KEY=
# Opcional: cambiar de modelo (por defecto claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Sesiones: cadena aleatoria de 32+ caracteres. En producción es obligatoria.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Usuario inicial (solo producción): se crea al arrancar si todavía no hay ningún usuario.
# Cuando ya has entrado una vez, puedes borrar estas dos variables.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# EMPRESA_NOMBRE=
